# Production environment — these values are baked into the Vite build at build time.
# Set VITE_STRIPE_PUBLIC_KEY to your live pk_live_... key before running `npm run build`.

VITE_API_URL=https://masterchefcuts-eqilqj43qa-uc.a.run.app

# GLB models are proxied through nginx (/gcs-static → GCS bucket).
# This avoids browser cross-origin restrictions that cause textures to render white.
VITE_GLB_BASE=/gcs-static

 # REQUIRED: Set via GitHub Actions secret VITE_STRIPE_PUBLIC_KEY (pk_live_...) before deploying.
# Do NOT commit a real key here. The CI/CD pipeline injects this at build time.
VITE_STRIPE_PUBLIC_KEY=pk_live_REPLACE_ME

# Sentry error monitoring — set via GitHub Actions secret VITE_SENTRY_DSN.
# Leave blank to disable Sentry in builds that don't set the secret.
VITE_SENTRY_DSN=
