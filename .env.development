# Development-only env vars — committed, no secrets here.
# Vite loads this automatically when running `npm run dev`.

# GLB model base path — routes through the Vite dev proxy (/gcs-static → GCS bucket).
# This avoids CORS white-texture issues when Three.js loads models cross-origin in dev.
# In production, nginx handles the same proxy (see nginx.conf and .env.production).
VITE_GLB_BASE=/gcs-static

# Logging level — debug prints all log levels in dev; set to warn or error to silence verbose output.
VITE_LOG_LEVEL=debug
